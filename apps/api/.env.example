ENVIRONMENT=development
DATABASE_URL=sqlite:///./scenecraft.db
JWT_SECRET_KEY=change-me-locally-never-commit-a-real-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALLOWED_ORIGINS=["http://localhost:3000"]

# Phase 2+: shared secret mcp_server sends on every /internal/* call — must
# match mcp_server/.env's INTERNAL_SERVICE_KEY exactly.
INTERNAL_SERVICE_KEY=change-me-locally-never-commit-a-real-secret

# Phase 2+: points at agents/.venv's interpreter so a script upload actually
# triggers the breakdown agent. Leave unset to keep jobs QUEUED-but-inert.
# Windows: agents\.venv\Scripts\python.exe / macOS-Linux: agents/.venv/bin/python
AGENTS_PYTHON_EXECUTABLE=
AGENTS_WORKING_DIR=

# Phase 5+: a real GCP project with the Firestore API enabled and a
# database created (see infra/firestore/firestore.rules). Leave unset to
# skip the live-trace mirror entirely — GET /jobs/{id} still works from
# Cloud SQL alone, just without the Firestore-pushed live panel.
GOOGLE_CLOUD_PROJECT=
