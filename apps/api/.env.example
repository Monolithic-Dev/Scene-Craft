ENVIRONMENT=development
DATABASE_URL=sqlite:///./scenecraft.db
JWT_SECRET_KEY=change-me-locally-never-commit-a-real-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALLOWED_ORIGINS=["http://localhost:3000"]

# Phase 2+: shared secret mcp_server sends on every /internal/* call — must
# match mcp_server/.env's INTERNAL_SERVICE_KEY exactly.
INTERNAL_SERVICE_KEY=change-me-locally-never-commit-a-real-secret

# Phase 2+: points at agents/.venv's interpreter so a script upload actually
# triggers the breakdown agent. Leave unset to keep jobs QUEUED-but-inert.
# Windows: agents\.venv\Scripts\python.exe / macOS-Linux: agents/.venv/bin/python
AGENTS_PYTHON_EXECUTABLE=
AGENTS_WORKING_DIR=

# Phase 5+: a real GCP project with the Firestore API enabled and a
# database created (see infra/firestore/firestore.rules). Leave unset to
# skip the live-trace mirror entirely — GET /jobs/{id} still works from
# Cloud SQL alone, just without the Firestore-pushed live panel.
GOOGLE_CLOUD_PROJECT=

# Phase 6+: Redis-backed distributed rate limiter (core/rate_limiter.py).
# `docker compose up -d redis` for local dev; Cloud Memorystore in
# staging/prod (see infra/terraform/redis.tf).
REDIS_URL=redis://localhost:6379/0

# Phase 6+: when set, agent_runner.py publishes to this Pub/Sub topic
# instead of spawning a local subprocess — see that module's docstring.
# Leave unset for local dev (AGENTS_PYTHON_EXECUTABLE above is what local
# dev actually uses).
PUBSUB_TOPIC=

# Phase 6+: OpenTelemetry trace export (core/telemetry.py). Read directly
# via the OTel SDK's own env-var convention, not through Settings above.
# Leave unset to keep spans local-only (no export, no error). Point at your
# Grafana Cloud OTLP gateway (or a self-hosted OTel Collector) once you have
# one — see infra/README.md.
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-<region>.grafana.net/otlp
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64(instance_id:api_key)>

