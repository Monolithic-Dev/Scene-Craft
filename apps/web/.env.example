# Defaults to http://localhost:8000 if unset.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Phase 5+: Firebase Web SDK config for the live agent-trace panel
# (lib/firebase.ts). Not secret — apiKey identifies the project, it doesn't
# authorize anything; real access control is
# infra/firestore/firestore.rules. Get these with:
#   firebase apps:sdkconfig WEB <app-id> --project <gcp-project-id>
# Leave unset to fall back to polling GET /jobs/{id} instead of a live
# Firestore subscription — same data, just not push-based.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
