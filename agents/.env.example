ENVIRONMENT=development

# From https://aistudio.google.com/apikey — text generation (breakdown_agent)
# and image captioning (frame_agent), both work on the free Developer API tier.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Vertex AI — frame image generation only (Phase 3+). Requires a real GCP
# project with billing + the Vertex AI API enabled; image generation does
# not work under a plain Developer API key (0 quota on the free tier).
# Leave blank to run everything except frame generation (breakdown still
# works with just GEMINI_API_KEY).
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
IMAGEN_MODEL=gemini-2.5-flash-image

# Local-dev stand-in for Cloud Storage (Phase 3+) — where generated frames
# are written. Defaults to agents/.local_storage when unset — leave this
# line commented out rather than set to an empty value, since an empty
# value (unlike an absent key) overrides that default with "".
# LOCAL_STORAGE_DIR=/absolute/path/to/somewhere/else

# Windows: mcp_server\.venv\Scripts\python.exe / macOS-Linux: mcp_server/.venv/bin/python
MCP_SERVER_PYTHON_EXECUTABLE=
MCP_SERVER_WORKING_DIR=../mcp_server

# Phase 6+: OpenTelemetry trace export (shared/telemetry.py). Read directly
# via the OTel SDK's own env-var convention. Leave unset to keep spans
# local-only (no export, no error) — see infra/README.md.
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-<region>.grafana.net/otlp
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64(instance_id:api_key)>
