# --- Environments / secrets -------------------------------------------------
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
!infra/**/*.tf

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.db
*.sqlite3
.local_storage/

# --- Node / Next.js ------------------------------------------------------------
node_modules/
.next/
out/
dist/
build/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Terraform -----------------------------------------------------------------
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
!*.tfvars.example
# dev/staging/prod.tfvars are committed deliberately — non-secret config
# only (project_id, region, environment, ...); real secrets are supplied as
# TF_VAR_* env vars, never written to a .tfvars file — see infra/README.md.
!infra/terraform/dev.tfvars
!infra/terraform/staging.tfvars
!infra/terraform/prod.tfvars
crash.log

# --- Editors / OS -----------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Logs / misc ---------------------------------------------------------------
*.log
.cache/
